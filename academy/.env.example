# ---------------------------------------------------------------
# Academy configuration. Copy to .env and fill in. Never commit .env
# ---------------------------------------------------------------
APP_NAME="Nibras Academy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://academy.example.ma
APP_TIMEZONE=Africa/Casablanca

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL / MariaDB (utf8mb4)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=academy
DB_USERNAME=academy
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Set when the app runs behind a reverse proxy / load balancer (e.g. "*" or IP list)
TRUSTED_PROXIES=

# Outgoing mail (verification and password reset emails)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@academy.example.ma"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Private lesson media -------------------------------------
# local       -> storage/app/private, streamed with HTTP byte ranges
# s3_private  -> private bucket, short-lived signed URLs
#               (requires: composer require league/flysystem-aws-s3-v3 "^3.0")
MEDIA_DISK=local
MEDIA_SIGNED_URL_MINUTES=10
VIDEO_MAX_MB=2048
VIDEO_CHUNK_MB=5
ATTACHMENT_MAX_MB=50

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_PRIVATE_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---- Optional AI quiz generator --------------------------------
# Leave empty to disable. The key can also be saved (encrypted) from
# Admin > Settings > AI. Pasted lesson text is sent to Anthropic.
ANTHROPIC_API_KEY=
AI_QUIZ_MODEL=claude-opus-5-5

# Only used by the demo seeder for local testing
DEMO_PASSWORD=
