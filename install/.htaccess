# Seul index.php et les vues incluses sont nécessaires ; aucun accès direct aux autres fichiers
Options -Indexes
<FilesMatch "^(?!index\.php$).+\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
