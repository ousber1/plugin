# ------------------------------------------------------------------
# BERRADI WALL ART - environment configuration
# Copy to ".env" (the installation wizard does this automatically).
# This file must NEVER be placed inside the public web directory.
# ------------------------------------------------------------------

APP_NAME="BERRADI WALL ART"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://www.example.com
# 64 hex chars, generated by the installer (php bin/console key:generate)
APP_KEY=
APP_TIMEZONE=Africa/Casablanca
APP_LOCALE=fr
# Admin area URL segment (change it to make the admin login harder to guess)
ADMIN_PATH=admin

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=

SESSION_NAME=bwa_session
SESSION_LIFETIME=120
# auto | true | false  (auto = secure cookie when the request is HTTPS)
SESSION_SECURE=auto

# Max size of one customer photo upload, in megabytes
UPLOAD_MAX_MB=25

LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15

# Mail transport is configured from the admin settings (SMTP). These are fallbacks.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="BERRADI WALL ART"
