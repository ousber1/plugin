msgid "Password updated. Sign in with your new password."
msgstr "تم تحديث كلمة المرور. سجّل الدخول بكلمة المرور الجديدة."

msgid "You have signed out."
msgstr "لقد سجّلت الخروج."

msgid "Your session expired. Please try again."
